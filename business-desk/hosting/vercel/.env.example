# Placeholder operator template. Never store actual secrets in Git.
# Use different private files/credentials/databases for preview and production.
DATABASE_URL=postgresql://RUNTIME_USER:REPLACE_PASSWORD@YOUR_DB_HOST/YOUR_DB?sslmode=require
DESK_PUBLIC_ORIGIN=https://YOUR_ACTUAL_APP_DOMAIN
DESK_SETUP_KEY=REPLACE_WITH_A_PRIVATE_GENERATED_VALUE
DESK_REGISTRATION_ENABLED=false
DESK_ALLOW_PREVIEW=false
DESK_DB_POOL_SIZE=4
# DATABASE_DIRECT_URL belongs in the operator environment for explicit migration,
# not in the deployed runtime, public assets or this committed template.
